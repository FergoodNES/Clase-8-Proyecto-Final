# ==============================================================================
# CONFIGURACION DE ENTORNO - INCIDENTHUB ENTERPRISE PRO
# Plantilla Segura sin credenciales reales para desarrollo y produccion
# ==============================================================================

# Puerto de escucha del servidor HTTP
PORT=3000

# Cadena de conexion para Prisma ORM (SQLite en local o PostgreSQL en cloud)
DATABASE_URL="file:./dev.db"

# Clave criptografica para firma de tokens JWT (Minimo 32 caracteres en produccion)
JWT_SECRET="reemplazar_con_clave_secreta_segura_minimo_32_caracteres"

# Tiempo de expiracion de tokens JWT
JWT_EXPIRES_IN="8h"

# Entorno de ejecucion: development | production | test
NODE_ENV=production

# Origenes permitidos para CORS (usar * para permitir acceso publico universal)
ALLOWED_ORIGINS="*"
