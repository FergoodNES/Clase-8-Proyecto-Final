{
  "name": "t1s8-plataforma-despliegue-segura",
  "version": "1.0.0",
  "description": "Unidad 8: Proyecto Integrador Final - Plataforma de gesti\u00f3n de incidentes con CRUD persistente, JWT, RBAC, logging estructurado, health check, monitoreo, pruebas E2E y despliegue productivo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "prisma generate && prisma db push",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:prod": "jest tests/produccion_e2e.test.js",
    "test:unit": "jest tests/reglasNegocio.unit.test.js",
    "test:integration": "jest tests/seguridad_integracion.test.js",
    "benchmark": "node scripts/benchmark_rendimiento.js",
    "health": "node scripts/check_health.js",
    "seed": "node prisma/seed.js",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "production",
    "deployment",
    "render",
        "docker",
    "health-check",
    "structured-logging",
    "mvc",
    "jwt",
    "rbac",
    "prisma",
    "sqlite"
  ],
  "author": "Fer",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  }
}
